<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Location Permissions -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Transmogrifier uses your location to provide context-aware productivity insights, such as commute time detection and geofence-based automation.</string>
    
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Transmogrifier uses your location for context-aware productivity insights.</string>
    
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Transmogrifier needs background location access to detect when you arrive at or leave places like home, office, or gym for automated workflow adjustments.</string>
    
    <!-- Background Modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
        <string>processing</string>
    </array>
    
    <!-- Background Tasks -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.transmogrifier.location.sync</string>
    </array>
    
    <!-- Privacy - Show location indicator -->
    <key>UIBackgroundLocationIndicator</key>
    <false/>
    
    <!-- App Transport Security (for development) -->
    <!-- Remove this in production! -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <!-- Development: Allow HTTP to localhost -->
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
            <!-- Development: Allow HTTP to local network -->
            <key>192.168.1.101</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
